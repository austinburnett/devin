[core]
	editor = nvim

###############################################################################
# Diffing

[diff]
	tool = nvimdiff
	algorithm = histogram
[difftool]
	prompt = false


###############################################################################
# Merging

[merge]
	conflictstyle = zdiff3
	tool = nvimdiff
[mergetool]
	prompt = false


[init]
	defaultBranch = develop
[rebase]
	autosquash = true
[pull]
	ff = only
[push]
	autoSetupRemote = true
[commit]
	verbose = true
[branch]
	sort = -committerdate
