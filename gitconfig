[core]
	editor = nvim


###############################################################################
# Diffing

[diff]
	tool = nvimdiff
	algorithm = histogram
[difftool]
	prompt = false

# Remove if not using GitBash on Windows.
[difftool "tgit"]
	cmd = "'C:\\Program Files\\TortoiseGit\\bin\\TortoiseGitProc' /command:repostatus /path $PWD"


###############################################################################
# Merging

[merge]
	tool = nvimdiff
	conflictstyle = zdiff3
[mergetool]
	prompt = false


[init]
	defaultBranch = develop
[rebase]
	autosquash = true
[pull]
	ff = only
[push]
	autoSetupRemote = true
[commit]
	verbose = true
[branch]
	sort = -committerdate
